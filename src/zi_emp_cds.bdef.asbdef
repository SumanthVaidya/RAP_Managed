managed;
strict ( 2 );

define behavior for ZI_Emp_CDS //alias <alias_name>
implementation in class zbp_i_emp_cds unique
persistent table zdb_employee
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  action ( features: instance )setAdmitted;
  update;
  delete;
  field ( readonly, numbering : managed ) Empid;
  association _empproj { create; }
}

define behavior for ZI_EMP_proj_cds //alias <alias_name>
//implementation in class zbp_i_empproj_cds unique
persistent table zbd_employeeproj
lock dependent by _emp
authorization dependent by _emp
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) Empid;
  association _emp;
}