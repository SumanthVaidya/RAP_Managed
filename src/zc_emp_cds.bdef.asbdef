projection;
strict ( 2 );

define behavior for ZC_EMP_CDS //alias <alias_name>
{
  use create;
  use update;
  use delete;
  use action setAdmitted;
  use association _empproj { create; }
}

define behavior for ZC_EMP_PROJ_CDS //alias <alias_name>
{
  use update;
  use delete;

  use association _emp;
}