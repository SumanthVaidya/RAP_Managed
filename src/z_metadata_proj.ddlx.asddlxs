@Metadata.layer: #CORE
annotate entity ZC_EMP_PROJ_CDS
    with 
{

@UI.facet:
             [{ id: 'General', 
                type: #IDENTIFICATION_REFERENCE, 
                label: 'Project Information'}]
   // @UI.facet: [{ id: 'Details', type: #IDE, label: 'Project Details', targetQualifier: 'Details' }]

   @UI.lineItem: [{ position: 10, label: 'Employee ID'}]
   @UI.identification: [{ position: 10, label: 'Employee ID'}]
    Empid;
    @UI.lineItem: [{ position: 20, label: 'Project ID' }]
    @UI.identification: [{ position: 20, label: 'Project ID'}]
    Projectid;
    @UI.lineItem: [{ position: 30, label: 'Project Name' }]
    @UI.identification: [{ position: 30, label: 'Project Name'}]
    Projectname;
    @UI.lineItem: [{ position: 40, label: 'Project Description' }]
    @UI.identification: [{ position: 40, label: 'Project Description'}]
    Projectdesc;
    @UI.lineItem: [{ position: 50, label: 'Start Date' }]
    @UI.identification: [{ position: 50, label: 'Start Date'}]
    Startdate;
    @UI.lineItem: [{ position: 60, label: 'End Date' }]
    @UI.identification: [{ position: 60, label: 'End Date'}]
    Enddate;
    @UI.lineItem: [{ position: 70, label: 'Project Manager' }]
    @UI.identification: [{ position: 70, label: 'Project Manager'}]
    Manager;
    /* Associations */
  //  _emp;;
    
}